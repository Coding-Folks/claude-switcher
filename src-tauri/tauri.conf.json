{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Switcher",
  "version": "0.1.0",
  "identifier": "id.codingfolks.claude-switcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "Claude Switcher",
        "url": "index.html",
        "width": 320,
        "height": 360,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
