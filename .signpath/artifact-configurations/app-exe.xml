<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app-exe": the program itself, uploaded by release.yml as a zip.
     Signing it gives the UAC prompt of the admin helper (the same exe) a verified publisher. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="claude-switcher.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
